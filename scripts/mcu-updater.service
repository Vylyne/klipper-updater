# Rendered by install.sh - %PLACEHOLDERS% are substituted there.
# Installed to /etc/systemd/system/mcu-updater.service
#
# The unit name is constrained from two directions, and neither is cosmetic:
#
#  * Moonraker only accepts a `managed_services` value matching the
#    [update_manager <name>] section, `klipper`, or `moonraker` - so the unit
#    name and that section name have to agree.
#  * KIAUH discovers instances with ^<component>(-[0-9a-zA-Z]+)?\.service$, so
#    anything called klipper-* is mistaken for a Klipper instance. It then tries
#    to read the unit and its whole menu crashes.
#
# Hence a name that does not begin with a component name at all. Do not rename
# this to klipper-anything.

[Unit]
Description=MCU Updater Moonraker Agent
Documentation=https://github.com/Vylyne/mcu-updater
# Wants, not Requires: a Moonraker restart must not take the agent down. It has
# its own reconnect loop, and in later phases a build or flash may be in flight.
After=moonraker.service
Wants=moonraker.service

[Service]
Type=simple
User=%USER%
Group=%USER%
WorkingDirectory=%INSTALL_DIR%
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%INSTALL_DIR%/src
ExecStart=%PYTHON% -m mcu_updater.agent \
    --socket %PRINTER_DATA%/comms/moonraker.sock \
    --log %PRINTER_DATA%/logs/mcu-updater.log \
    --shutdown-grace 280
Restart=always
RestartSec=5
KillSignal=SIGTERM

# The agent can stop klipper to flash a board, so shutdown has to be careful.
#
# TimeoutStopSec must exceed --shutdown-grace: on SIGTERM the agent refuses to
# exit while a flash is in progress, because killing flashtool part-way leaves a
# board with half an image. systemd would otherwise SIGKILL it mid-write.
TimeoutStopSec=300

# Outermost safety net. If the agent dies in a way that skips every other layer -
# SIGKILL, OOM, a panic - klipper could be left stopped and the printer dead until
# someone notices. This runs even then.
#
# The other three layers, in order of preference: the finally block in
# klipper_stopped(); MoonrakerService.start() falling through to systemctl; and
# the journal at ~/mcus/.updater.state, which the agent reconciles on startup.
ExecStopPost=/bin/sh -c 'systemctl is-active --quiet klipper || systemctl start klipper'

# The log lands in printer_data/logs so it sits with the others and is reachable
# through Moonraker's file manager. Note it will NOT appear in Mainsail's
# Logfiles panel: that panel renders a hardcoded list (klippy, moonraker,
# crowsnest, mmu, sonar), not whatever happens to be in the directory.

[Install]
WantedBy=multi-user.target
